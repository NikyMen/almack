# Clave de API de DeepSeek para las funciones de IA
# Consíguela en https://console.anthropic.com/
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash

# Autenticación (login). Valores por defecto en desarrollo: admin / admin
AUTH_USER=admin
AUTH_PASSWORD=admin
# Secreto para firmar la cookie de sesión (cambialo en producción)
AUTH_SECRET=cambia-este-secreto-largo-y-aleatorio

# MercadoPago — cobros online de la tienda pública (/store)
# Access Token de "Tus integraciones → Credenciales" en el panel de MercadoPago.
# Con un token TEST se cobra en sandbox (sin plata real); con el PROD, real.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
# URL pública del sitio (con HTTPS en producción). Se usa para las back_urls del
# checkout y para el webhook de confirmación. MercadoPago debe poder alcanzarla
# (en local, usá un túnel tipo ngrok; localhost no recibe webhooks).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
