# Clave de API de DeepSeek para las funciones de IA
# Conseguíla en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# deepseek-v4-flash (barato, por defecto) o deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
# Sólo si apuntás a un proxy u otro proveedor compatible con el formato OpenAI:
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Imágenes de remitos y carga masiva: Gemini + DeepSeek ---
# Creá una clave en Google AI Studio. El nivel gratuito tiene cuotas limitadas.
# Modelo por defecto: gemini-3.8-flash. Opcional: GEMINI_MODEL.
# Guardala solo en el servidor; nunca uses NEXT_PUBLIC_ para estas claves.
GEMINI_API_KEY=
# Google extrae el texto; DEEPSEEK_API_KEY lo convierte en productos.

# Base persistente para producción/Vercel. En desarrollo, si no se definen,
# la aplicación sigue usando el archivo local gestoria.db.
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu-token

# Autenticación (login). Valores por defecto en desarrollo: admin / admin
AUTH_USER=admin
AUTH_PASSWORD=admin
# Secreto para firmar la cookie de sesión (cambialo en producción)
AUTH_SECRET=cambia-este-secreto-largo-y-aleatorio

# MercadoPago — cobros online de la tienda pública (/store)
# Access Token de "Tus integraciones → Credenciales" en el panel de MercadoPago.
# Con un token TEST se cobra en sandbox (sin plata real); con el PROD, real.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
# URL pública del sitio (con HTTPS en producción). Se usa para las back_urls del
# checkout y para el webhook de confirmación. MercadoPago debe poder alcanzarla
# (en local, usá un túnel tipo ngrok; localhost no recibe webhooks).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Respaldo de lectura si Gemini falla temporalmente (consume saldo DeepSeek):
# DEEPSEEK_VISION_MODEL=deepseek-flash
