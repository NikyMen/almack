{
  "name": "almack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "vercel-build": "pnpm db:push && next build",
    "start": "next start",
    "lint": "next lint",
    "security:check": "node scripts/check-push.mjs --working-tree && pnpm audit --audit-level low && node node_modules/typescript/bin/tsc --noEmit",
    "test:stock-import": "node scripts/run-stock-import-tests.mjs",
    "test:transfers": "node scripts/run-transfer-tests.mjs",
    "db:push": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "dev:setup": "node --env-file=.env.local --import tsx src/db/migrate.ts && node --env-file=.env.local --import tsx src/db/demo.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@libsql/client": "^0.14.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "baileys": "7.0.0-rc13",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.24",
    "ogl": "^1.0.11",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.185.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "exceljs>uuid": "11.1.1",
      "esbuild": ">=0.28.1 <0.29.0",
      "nanoid": ">=3.3.18 <4.0.0",
      "postcss": ">=8.5.23 <9.0.0",
      "protobufjs": ">=7.6.5 <8.0.0",
      "sharp": ">=0.35.4 <0.36.0"
    }
  }
}
